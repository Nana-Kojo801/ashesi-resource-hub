---
import { ViewTransitions } from 'astro:transitions';
import { CATEGORY_COLORS } from '../lib/categories';

export interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Every official Ashesi link, on one board.' } = Astro.props;

const stripeColors = Object.entries(CATEGORY_COLORS)
  .filter(([name]) => name !== 'Emergency')
  .map(([, color]) => color);
---
<!doctype html>
<html lang="en" transition:animate="fade">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} · Ashesi Resource Hub</title>
  <meta name="description" content={description} />
  <link rel="icon" href="data:," />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..800&family=Martian+Mono:wght@400;500;600&display=swap"
    rel="stylesheet"
  />
  <ViewTransitions />
</head>
<body>
  <div class="page">
    <div class="stripe" aria-hidden="true">
      {stripeColors.map((c) => <span style={`background:${c}`}></span>)}
    </div>

    <header class="site-header">
      <div class="wrap header-inner">
        <a href="/" class="logo" aria-label="Ashesi Resource Hub">
          <span class="logo-mark">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="square"><path d="M4 6h16M4 12h10M4 18h13"></path></svg>
          </span>
          <span class="wordmark">Resource Hub</span>
        </a>
        <span class="spacer"></span>
        <a href="/emergency" class="sos-btn">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="square"><path d="M12 3 4 6.4v5.8c0 4.6 3.2 8 8 9.8 4.8-1.8 8-5.2 8-9.8V6.4z"></path><path d="M12 8.6v4.6M12 16.6v.9"></path></svg>
          SOS
        </a>
      </div>
    </header>

    <main class="site-main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <p>Ashesi Resource Hub — a student-facing directory of official Ashesi links. Not affiliated content is never linked. Something wrong? Open any resource and flag it.</p>
      </div>
    </footer>
  </div>

  <script>
    import '../scripts/motion';
  </script>
</body>
</html>

<style is:global>
  :root {
    --bg: #F6EFE0;
    --card: #FFFDF7;
    --input-bg: #FFFBF2;
    --text: #1C1614;
    --muted: #6B5F58;
    --muted-2: #4A403B;
    --border: #E4D9C7;
    --border-2: #ECE1CE;
    --border-3: #D9CBB5;
    --primary: #A93C40;
    --primary-hover: #8E2F33;
    --primary-hover-2: #7E2A2E;
    --success: #2F7A63;
    --success-2: #276852;
    --warning: #D97A2B;
    --warning-2: #96501C;
    --warning-3: #5B4023;
    --warning-bg: #FBEEDD;
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; }
  body {
    background: var(--bg);
    color: var(--text);
    font-family: Archivo, system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
    text-wrap: pretty;
  }
  button, input, textarea { font: inherit; color: inherit; outline: none; }
  a { color: var(--primary); text-underline-offset: 3px; text-decoration: none; }
  a:hover { color: var(--primary-hover-2); }
  ::placeholder { color: var(--muted); }
  ::selection { background: var(--primary); color: #fff; }

  .mono {
    font-family: 'Martian Mono', monospace;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  @keyframes slidein { from { transform: translateX(3%); opacity: 0; } to { transform: none; opacity: 1; } }
  @keyframes fade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes rise { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }

  .page { min-height: 100vh; display: flex; flex-direction: column; background: var(--bg); }
  .wrap { max-width: 1180px; margin: 0 auto; padding: 0 clamp(12px, 3vw, 26px); }

  .stripe { display: flex; height: 5px; flex: 0 0 auto; }
  .stripe span { flex: 1; }

  .site-header {
    position: sticky; top: 0; z-index: 40;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
  }
  .header-inner {
    display: flex; align-items: center; gap: clamp(6px, 1.6vw, 16px);
    min-height: 58px; flex-wrap: wrap; padding: 6px 0;
  }
  .logo { display: flex; align-items: center; gap: 8px; flex: 0 0 auto; }
  .logo-mark {
    width: 26px; height: 26px; background: var(--primary);
    display: grid; place-items: center; flex: 0 0 auto;
  }
  .wordmark {
    font-weight: 800; font-stretch: 112%; letter-spacing: 0.02em;
    font-size: 14px; text-transform: uppercase; white-space: nowrap; color: var(--text);
  }
  .spacer { flex: 1; }
  .sos-btn {
    flex: 0 0 auto; display: flex; align-items: center; gap: 7px;
    background: var(--primary); color: #fff; border: none; padding: 9px 13px;
    cursor: pointer; font-family: 'Martian Mono', monospace; font-size: 10px;
    font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase;
    transition: background 0.14s ease;
  }
  .sos-btn:hover { background: var(--primary-hover); color: #fff; }

  .site-main { flex: 1; }

  .site-footer { border-top: 1px solid var(--border); padding: 24px 0 40px; }
  .site-footer p {
    font-family: 'Martian Mono', monospace; font-size: 10px; line-height: 1.7;
    color: var(--muted); max-width: 60ch; margin: 0;
  }

  .dashed {
    border: 1px dashed var(--border-3);
  }
</style>

---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import Hub from "../../components/Hub.svelte";
import { flattenResource } from "../../lib/presentation";
export async function getStaticPaths() {
  const resources = (await getCollection("resources"))
    .filter((r) => r.data.status === "active")
    .map(flattenResource);
  return resources.map((resource) => ({
    params: { slug: resource.slug },
    props: { resource, resources },
  }));
}
const { resource, resources } = Astro.props;
---

<Base title={resource.title} description={resource.description}>
  <Hub client:load mode="detail" {resource} {resources} />
</Base>

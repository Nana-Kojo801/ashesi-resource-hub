---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import FlagButton from '../../components/FlagButton.svelte';
import { categoryColor, slugifyCategory } from '../../lib/categories';

export async function getStaticPaths() {
  const all = await getCollection('resources');
  const active = all.filter((r) => r.data.status === 'active');
  return active.map((r) => ({
    params: { slug: r.id },
    props: { resource: r },
  }));
}

const { resource } = Astro.props;
const { title, description, type, access, url, category, aliases } = resource.data;
const color = categoryColor(category);

let host = url.replace(/^mailto:/, '').replace(/^tel:/, '');
if (/^https?:\/\//.test(url)) host = url.replace(/^https?:\/\//, '').split('/')[0];

const isExternalLink = /^https?:\/\//.test(url);
---

<Base title={title} description={description}>
  <div class="wrap detail-wrap">
    <a class="back mono" href={`/category/${slugifyCategory(category)}`}>← Back</a>

    <article class="drawer">
      <div class="drawer-top" style={`background:${color}`}></div>
      <div class="drawer-body">
        <span class="cat-label mono" style={`color:${color}`}>{category}</span>
        <h1>{title}</h1>
        <p class="desc">{description}</p>

        {aliases && aliases.length > 0 && (
          <div class="aliases">
            <p class="aliases-label mono">Students also call it</p>
            <div class="alias-chips">
              {aliases.map((a: string) => (
                <span class="alias-chip mono">{a}</span>
              ))}
            </div>
          </div>
        )}

        <dl class="kv">
          <div class="kv-row">
            <dt class="mono">Type</dt>
            <dd>{type}</dd>
          </div>
          <div class="kv-row">
            <dt class="mono">Access</dt>
            <dd>{access}</dd>
          </div>
          <div class="kv-row">
            <dt class="mono">Goes to</dt>
            <dd>{host}</dd>
          </div>
          <div class="kv-row">
            <dt class="mono">Verified</dt>
            <dd>2026-09-19</dd>
          </div>
        </dl>

        <a
          class="open-btn mono"
          href={url}
          target={isExternalLink ? '_blank' : undefined}
          rel={isExternalLink ? 'noopener noreferrer' : undefined}
        >
          Open resource
        </a>

        <div class="flag-slot">
          <FlagButton client:visible resourceSlug={resource.id} resourceTitle={title} />
        </div>
      </div>
    </article>
  </div>
</Base>

<script>
  // no-op placeholder for future GSAP mount-in polish
</script>

<style>
  .detail-wrap { padding-top: 28px; padding-bottom: 64px; max-width: 640px; }
  .back { display: inline-block; font-size: 10px; color: var(--muted); margin-bottom: 18px; }
  .back:hover { color: var(--text); }

  .drawer {
    background: #FFFBF2;
    border: 1px solid var(--border);
    animation: rise 0.22s cubic-bezier(0.2, 0.8, 0.3, 1);
  }
  .drawer-top { height: 4px; }
  .drawer-body { padding: clamp(20px, 4vw, 32px); }
  .cat-label { font-size: 10px; display: block; margin-bottom: 10px; }
  h1 {
    font-weight: 800; font-stretch: 116%; font-size: clamp(22px, 4vw, 30px);
    text-transform: uppercase; letter-spacing: -0.01em; margin: 0 0 14px; line-height: 1.05;
  }
  .desc { font-size: 14.5px; line-height: 1.6; color: var(--muted-2); margin: 0 0 22px; }

  .aliases { margin-bottom: 22px; }
  .aliases-label { font-size: 9.5px; color: var(--muted); margin: 0 0 8px; }
  .alias-chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .alias-chip {
    background: var(--warning-bg); border: 1px solid var(--border-3); color: var(--muted-2);
    padding: 5px 9px; font-size: 9.5px;
  }

  .kv { margin: 0 0 24px; }
  .kv-row {
    display: flex; justify-content: space-between; gap: 12px;
    padding: 10px 0; border-bottom: 1px solid var(--border-2);
    font-size: 13px;
  }
  .kv-row dt { color: var(--muted); font-size: 9.5px; margin: 0; }
  .kv-row dd { margin: 0; color: var(--text); text-align: right; word-break: break-word; }

  .open-btn {
    display: flex; align-items: center; justify-content: center; gap: 9px;
    width: 100%; text-decoration: none; background: var(--primary); color: #fff;
    padding: 15px; font-size: 11px; font-weight: 600; margin-bottom: 12px;
  }
  .open-btn:hover { background: var(--primary-hover); color: #fff; }

  .flag-slot { margin-top: 4px; }
</style>


---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import Hub from "../../components/Hub.svelte";
import { flattenResource } from "../../lib/presentation";
import { slugifyCategory } from "../../lib/categories";
export async function getStaticPaths() {
  const resources = (await getCollection("resources"))
    .filter((r) => r.data.status === "active")
    .map(flattenResource);
  return [...new Set(resources.map((r) => r.category))].map((category) => ({
    params: { slug: slugifyCategory(category) },
    props: { category, resources },
  }));
}
const { category, resources } = Astro.props;
---

<Base title={category}>
  <Hub
    client:load
    mode={category === "Offices & People" ? "people" : "category"}
    {category}
    {resources}
  />
</Base>

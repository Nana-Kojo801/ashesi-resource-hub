---
import Base from '../layouts/Base.astro';

const EMERGENCY = [
  {
    tag: 'Security incident',
    who: 'Ashesi Security',
    number: '+233 201 722 818',
    icon: 'shield',
  },
  {
    tag: 'Medical emergency',
    who: 'Natembea Health Center',
    number: '+233 501 331 668',
    icon: 'cross',
  },
  {
    tag: 'Sexual misconduct',
    who: 'First response & reporting support',
    number: '+233 501 260 277',
    icon: 'alert',
  },
  {
    tag: 'General support',
    who: 'Ashesi general support line',
    number: '+233 501 673 669',
    icon: 'buoy',
  },
];

function tel(n: string) {
  return 'tel:' + n.replace(/[^0-9+]/g, '');
}

const ICONS: Record<string, string> = {
  shield: 'M12 3 4 6.4v5.8c0 4.6 3.2 8 8 9.8 4.8-1.8 8-5.2 8-9.8V6.4z|M12 8.6v4.6M12 16.4v1',
  cross: 'M12 3.6a8.4 8.4 0 1 0 0 16.8 8.4 8.4 0 0 0 0-16.8|M12 8.2v7.6M8.2 12h7.6',
  alert: 'M12 3.4 21 19.6H3z|M12 9.6v4.4M12 16.8v1',
  buoy: 'M12 3.4a8.6 8.6 0 1 0 0 17.2 8.6 8.6 0 0 0 0-17.2|M12 8.4a3.6 3.6 0 1 0 0 7.2 3.6 3.6 0 0 0 0-7.2|M5.9 5.9 9.4 9.4M18.1 5.9 14.6 9.4M5.9 18.1l3.5-3.5M18.1 18.1l-3.5-3.5',
};
---

<Base title="Emergency" description="Campus safety numbers, one tap away.">
  <div class="emergency-top">
    <div class="wrap">
      <span class="sos-tag mono">SOS · Campus safety</span>
      <h1>If it's urgent, call now. Don't wait for a form.</h1>
    </div>
  </div>

  <section class="wrap emergency-list">
    {EMERGENCY.map((e) => (
      <a class="emergency-row" href={tel(e.number)}>
        <span class="icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square">
            {ICONS[e.icon].split('|').map((d) => <path d={d}></path>)}
          </svg>
        </span>
        <span class="body">
          <span class="tag mono">{e.tag}</span>
          <span class="who">{e.who}</span>
        </span>
        <span class="number mono">{e.number}</span>
      </a>
    ))}

    <a class="emergency-row" href="mailto:hotline@ashesi.edu.gh">
      <span class="icon">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"><path d="M4 5h16v14H4z"></path><path d="m4 6 8 7 8-7"></path></svg>
      </span>
      <span class="body">
        <span class="tag mono">Academic emergency</span>
        <span class="who">Academic Affairs Hotline — 24/7 urgent academic assistance</span>
      </span>
      <span class="number mono">hotline@ashesi.edu.gh</span>
    </a>
  </section>

  <section class="wrap back-link">
    <a href="/" class="mono">← Back to the resource board</a>
  </section>
</Base>

<style>
  .emergency-top { background: var(--primary); color: #fff; padding: clamp(30px, 6vw, 56px) 0; }
  .sos-tag { display: inline-block; font-size: 10px; color: #fff; opacity: 0.85; margin-bottom: 14px; }
  .emergency-top h1 {
    font-weight: 800; font-stretch: 118%; font-size: clamp(24px, 5vw, 44px);
    line-height: 1.02; letter-spacing: -0.01em; text-transform: uppercase; margin: 0; max-width: 20ch;
  }

  .emergency-list { padding: 28px 0 8px; }
  .emergency-row {
    display: flex; align-items: center; gap: 16px;
    padding: 18px 4px; border-bottom: 1px solid var(--border);
    color: var(--text);
  }
  .emergency-row:hover { color: var(--text); background: #FFFBF0; }
  .icon {
    flex: 0 0 auto; width: 40px; height: 40px; display: grid; place-items: center;
    background: var(--warning-bg); color: var(--primary);
  }
  .body { display: flex; flex-direction: column; gap: 4px; flex: 1; min-width: 0; }
  .tag { font-size: 9.5px; color: var(--muted); }
  .who { font-size: 14.5px; font-weight: 700; }
  .number { flex: 0 0 auto; font-size: 12px; color: var(--muted-2); white-space: nowrap; }

  .back-link { padding: 24px 0 56px; }
  .back-link a { font-size: 10px; color: var(--muted); }
  .back-link a:hover { color: var(--text); }
</style>

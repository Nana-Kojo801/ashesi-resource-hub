# Vite frontend env vars. Copy this file to .env and fill in real values for
# local development. In production these are set as Netlify environment
# variables (Site configuration → Environment variables) — VITE_ prefixed
# vars are the only ones exposed to client-side code, by Vite convention.
#
# NOTE: this is renamed from PUBLIC_CONVEX_URL (the Astro/main-branch name)
# to VITE_CONVEX_URL here, because Vite only exposes env vars prefixed with
# VITE_ to client code (Astro's convention was PUBLIC_). Same variable,
# same value, new prefix required by the build tool.

# The deployed Convex deployment URL (from `pnpm dlx convex dev` locally, or
# your production deployment after `pnpm dlx convex deploy`). Used by
# FlagButton.tsx to talk to the reports table.
VITE_CONVEX_URL=https://your-deployment-name.convex.cloud

# Astro / frontend env vars. Copy this file to .env and fill in real values
# for local development. In production these are set as Cloudflare Pages
# environment variables (Settings → Environment variables) — PUBLIC_ prefixed
# vars are the only ones exposed to client-side code, by Astro convention.

# The deployed Convex deployment URL (from `pnpm dlx convex dev` locally, or
# your production deployment after `pnpm dlx convex deploy`). Used by
# FlagButton.svelte to talk to the reports table.
PUBLIC_CONVEX_URL=https://your-deployment-name.convex.cloud
